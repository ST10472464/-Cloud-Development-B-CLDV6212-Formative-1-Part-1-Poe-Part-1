{
  "info": {
    "name": "CoffeeNChill API - Part 1 Complete Collection",
    "_postman_id": "coffeennchill-part1-complete",
    "description": "Complete API collection for CoffeeNChill Part 1 - Menu CRUD + Document Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7058/api"
    }
  ],
  "item": [
    {
      "name": "Menu Operations",
      "item": [
        {
          "name": "Create Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.PartitionKey).to.eql('Hot Drinks');",
                  "    pm.expect(json.RowKey).to.eql('COF-001');",
                  "    pm.expect(json.Name).to.eql('Espresso');",
                  "    pm.expect(json.Price).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": ["{{baseUrl}}"],
              "path": ["menu"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"PartitionKey\": \"Hot Drinks\",\n  \"RowKey\": \"COF-001\",\n  \"Name\": \"Espresso\",\n  \"Description\": \"Strong Italian coffee shot\",\n  \"Price\": 25.00,\n  \"IsAvailable\": true\n}"
            }
          }
        },
        {
