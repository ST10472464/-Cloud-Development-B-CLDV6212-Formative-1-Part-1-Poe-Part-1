            "body": {
              "mode": "raw",
              "raw": "{\n  \"Name\": \"Espresso\",\n  \"Description\": \"Strong Italian coffee shot\",\n  \"Price\": 30.00,\n  \"IsAvailable\": true\n}"
            }
