                  "    pm.expect(json.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": ["{{baseUrl}}"],
              "path": ["menu"]
            }
          }
        },
        {
          "name": "Get Menu Items By Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All items match category', function () {",
                  "    var json = pm.response.json();",
                  "    json.forEach(function(item) {",
                  "        pm.expect(item.PartitionKey).to.eql('Hot Drinks');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu/category/Hot Drinks",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "category", "Hot Drinks"]
            }
          }
        },
        {
