    {
      "name": "5. Get Order Status from Orders Table (expect 200 or 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Endpoint responds with 200 or 404', function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test('Order record carries a lifecycle status', function () {",
              "        const body = pm.response.json();",
              "        pm.expect(body).to.have.property('Status');",
              "        pm.expect(body).to.have.property('RowKey');",
              "        pm.expect(['Received', 'Preparing', 'Ready', 'Collected']).to.include(body.Status);",
              "    });",
              "",
              "    pm.test('PartitionKey is the order date (yyyy-MM-dd)', function () {",
              "        const body = pm.response.json();",
              "        pm.expect(body.PartitionKey).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderDate}}/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderDate}}",
            "{{orderId}}"
          ]
        }
      },
      "response": []
