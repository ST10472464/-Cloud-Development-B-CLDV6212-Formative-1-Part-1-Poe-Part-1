  "item": [
    {
      "name": "1. Place Order - Valid (expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Order was queued successfully', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.eql('Order queued successfully');",
              "    pm.expect(body.orderId).to.eql('ORD-2026-8801');",
              "});",
              "",
              "pm.test('Response is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Response time under 2000 ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"OrderId\": \"ORD-2026-8801\",\r\n  \"CustomerName\": \"Jane Smith\",\r\n  \"SelectedItemSKUs\": [\"COF-001\", \"PAS-104\"],\r\n  \"TotalPrice\": 65.00,\r\n  \"OrderTimestamp\": \"2026-10-12T10:15:00Z\"\r\n}",
          "options": {
