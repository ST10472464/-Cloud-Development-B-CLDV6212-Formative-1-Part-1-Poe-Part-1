    {
      "name": "6. List Orders by Date from Orders Table (expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array of order records', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "});",
              "",
              "pm.test('Each order has an Id, customer and status', function () {",
              "    const body = pm.response.json();",
              "    body.forEach(function (order) {",
              "        pm.expect(order).to.have.property('RowKey');",
              "        pm.expect(order).to.have.property('CustomerName');",
              "        pm.expect(order).to.have.property('Status');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderDate}}",
          "host": [
            "{{baseUrl}}"
          ],
